# ========================================================
# StiCommande Docker Compose Security Configuration
# ========================================================
# Copy this file to .env (chmod 600 .env) and set strong passwords!

APP_NAME=StiCommande
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:Sm9obkRvZUlzQUZha2VLZXlGb3JUZXN0aW5nMTIzNDU=
APP_URL=https://yourdomain.com

# PostgreSQL Secure Credentials
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sticommande
DB_USERNAME=sticommande_user
DB_PASSWORD=YOUR_STRONG_RANDOM_POSTGRES_PASSWORD_HERE

# Redis Secure Credentials
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_STRONG_RANDOM_REDIS_PASSWORD_HERE

# Container Startup Controls
RUN_MIGRATIONS=true
START_WEBSOCKET=true
START_QUEUE_WORKER=true
