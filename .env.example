# =========================================================
# StiCommande - Docker Compose environment (root stack)
# Copy this file to `.env` (same folder as docker-compose.yml), edit it,
# then start with:  docker compose --profile full up -d --build
# =========================================================

# ---------- Public entrypoints ----------
# Gateway (nginx) is the only service exposed to the network.
GATEWAY_BIND=0.0.0.0
GATEWAY_PORT=80
GATEWAY_SSL_PORT=443
# Identity of the auto-generated TLS certificate (must match what users type).
# Comma separated, domains and/or IPs, e.g.:
#   TLS_CN=192.168.1.50
#   TLS_CN=app.example.com,192.168.1.50
TLS_CN=192.168.1.50

# App ports stay on localhost: they are reached through the gateway only.
# Set BIND_HOST=0.0.0.0 only if you run WITHOUT the gateway profile.
BIND_HOST=127.0.0.1
BACKEND_PORT=8000
WS_PORT=8085
FRONTEND_PORT=3000

# ---------- Application ----------
APP_NAME=StiCommande
APP_ENV=production
APP_DEBUG=false
# Public URL of the app = the address users type in the browser.
# LAN only:  http://192.168.1.50   (or https://192.168.1.50 if you use 443)
# Internet:  https://app.example.com   (domain or public IP + port forwarding)
APP_URL=http://192.168.1.50
# Generate with: php artisan key:generate --show
# Leave empty to have the container generate and persist one on first boot.
APP_KEY=

# ---------- PostgreSQL ----------
DB_DATABASE=sticommande_db
DB_USERNAME=sticommande_user
# REQUIRED: change before production (PostgreSQL refuses an empty password)
DB_PASSWORD=CHANGE_ME_strong_random_password

# ---------- Redis ----------
# REQUIRED: change before production
REDIS_PASSWORD=CHANGE_ME_strong_random_redis_password

# ---------- Startup controls ----------
RUN_MIGRATIONS=true
START_WEBSOCKET=true
START_QUEUE_WORKER=true

# ---------- Frontend (baked into the client bundle at build time) ----------
# Served through the gateway: keep the default (no port) so remote browsers
# are rewritten to the host they are actually talking to.
NEXT_PUBLIC_API_URL=http://localhost/api
# Leave empty: the client connects to same-origin /ws (proxied by the gateway).
# Set only if you expose the websocket hub on a different origin.
NEXT_PUBLIC_WS_URL=

# ---------- TLS ----------
# Put fullchain.pem + privkey.pem into ./certs to use real certificates.
# Without them a self-signed certificate is generated on first start.
